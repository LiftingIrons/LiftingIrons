{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "lifting-irons-fitness",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "privacy": "public",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liftingirons.fitnessapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses camera for progress photos",
        "NSPhotoLibraryUsageDescription": "This app accesses photo library for progress tracking"
      }
    },
    "android": {
      "package": "com.liftingirons.fitnessapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#3B82F6"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Lifting Irons - Fitness App",
      "shortName": "Lifting Irons",
      "lang": "en",
      "scope": "/",
      "themeColor": "#3B82F6",
      "backgroundColor": "#F9FAFB"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "779ea4b8-da64-4396-9b9b-082ee5d5061f"
      }
    },
    "owner": "liftingirons"
  }
}
